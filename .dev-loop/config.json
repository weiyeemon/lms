{
  "$schema": "../.agent-workflow/schemas/config.schema.json",
  "schema_version": 1,
  "workflow_version": "0.8.0",
  "max_review_iterations": 4,
  "protected_branches": [
    "main",
    "master",
    "develop",
    "release/*"
  ],
  "feature_branch_template": "feature/{task_slug}",
  "gates": [
    {
      "name": "tests",
      "command": "npm.cmd test",
      "timeout_seconds": 120
    },
    {
      "name": "lint",
      "command": "npm.cmd run lint",
      "timeout_seconds": 120
    },
    {
      "name": "typecheck",
      "command": "npx.cmd tsc --noEmit",
      "timeout_seconds": 120
    },
    {
      "name": "build",
      "command": "npm.cmd run build",
      "timeout_seconds": 300
    }
  ],
  "test_integrity": {
    "paths": [
      "__tests__",
      "vitest.config.mts"
    ],
    "allow_existing_test_changes": false
  }
}
