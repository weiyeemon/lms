# Required by the Next.js application and Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Required only when running the automated E2E setup against a test project.
SUPABASE_SERVICE_ROLE_KEY=your-test-project-service-role-key
E2E_EMAIL=e2e.employee@example.com
E2E_PASSWORD=replace-with-a-secure-test-password

PLAYWRIGHT_BASE_URL=http://127.0.0.1:3100
