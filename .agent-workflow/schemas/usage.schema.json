{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "session_id", "scope", "status", "coverage", "providers", "invocations", "usage", "by_provider", "started_at", "updated_at", "duration_ms"],
  "properties": {
    "schema_version": { "const": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "scope": { "const": "task" },
    "status": { "enum": ["partial", "complete"] },
    "coverage": { "enum": ["root_thread_only", "invocation_aggregate", "mixed", "unavailable"] },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["codex", "claude"] }
    },
    "started_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "invocations": { "type": "array", "minItems": 1 },
    "usage": { "$ref": "#/$defs/usage" },
    "by_provider": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/usage" }
    }
  },
  "$defs": {
    "usage": {
      "type": "object",
      "required": ["status", "input_tokens", "cached_input_tokens", "cache_creation_input_tokens", "output_tokens", "reasoning_output_tokens", "total_tokens"],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_creation_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
