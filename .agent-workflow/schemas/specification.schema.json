{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "title", "summary", "sources", "current_behavior", "desired_behavior", "acceptance_criteria", "constraints", "non_goals", "assumptions", "open_questions"],
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "reference", "facts"],
        "properties": {
          "type": { "enum": ["context", "github", "jira", "repository", "clarification"] },
          "reference": { "type": "string", "minLength": 1 },
          "facts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "current_behavior": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "desired_behavior": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "behavior", "verification"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[1-9][0-9]*$" },
          "behavior": { "type": "string", "minLength": 1 },
          "verification": { "type": "string", "minLength": 1 }
        }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "non_goals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "open_questions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
