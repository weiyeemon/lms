{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "workflow_version", "session_id", "task", "status", "branch", "baseline_commit", "acceptance_criteria", "gates", "iteration"],
  "properties": {
    "version": { "const": 1 },
    "workflow_version": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "status": { "enum": ["awaiting_plan_approval", "planned", "in_progress", "awaiting_user", "approved", "max_iterations", "escalated", "aborted"] },
    "branch": { "type": "string", "minLength": 1 },
    "baseline_commit": { "type": "string", "minLength": 1 },
    "acceptance_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "specification_path": { "type": "string", "minLength": 1 },
    "gates": { "type": "array", "minItems": 1 },
    "iteration": { "type": "integer", "minimum": 0 },
    "iteration_limit": { "type": "integer", "minimum": 1 }
  }
}
